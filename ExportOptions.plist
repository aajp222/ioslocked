<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by ios/archive.sh when exporting the archive for upload. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>2MUHC6TNGW</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- TestFlight and the App Store both want the bitcode-free, symbol-rich
	     upload; symbols make crash reports readable. -->
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
