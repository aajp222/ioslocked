<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- TestFlight and the App Store use the PRODUCTION APNs environment. A
	     development value here means Apple hands out sandbox tokens that the
	     production push host rejects, and notifications fail silently. -->
	<key>aps-environment</key>
	<string>production</string>

	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>

	<!-- Family Controls (Distribution), approved by Apple 6 Aug 2026. This is
	     what makes the block real for people who install from TestFlight rather
	     than from Xcode. -->
	<key>com.apple.developer.family-controls</key>
	<true/>

	<!-- Kept in step with Locked.entitlements. These two files drifting apart
	     is the classic version of this bug: the bridge works from Xcode and is
	     silently absent on TestFlight, where nothing errors and the goal chips
	     just never change. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.aaryanpanchal.locked</string>
		<string>group.com.aaryanpanchal.orbitlocked</string>
	</array>
</dict>
</plist>
